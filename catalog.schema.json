{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shiv-source/skills-marketplace/blob/main/catalog.schema.json",
  "title": "Skills Marketplace Catalog",
  "description": "Catalog of agent skills for opencode/Claude. Generated from skills/*/SKILL.md frontmatter by scripts/generate.mjs.",
  "type": "object",
  "required": ["schemaVersion", "name", "description", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["slug", "name", "description", "path"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    }
  }
}
